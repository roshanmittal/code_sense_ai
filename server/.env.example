# CodeSense AI Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g. mongodb://127.0.0.1:27017/codesense_ai or MongoDB Atlas)
# If local MongoDB is not running, an in-memory database will be initialized automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/codesense_ai

# JWT Security
JWT_SECRET=codesense_ai_secret_jwt_key_development_32chars_long
JWT_EXPIRES_IN=7d

# LLM / AI Configuration (Google Gemini / OpenAI compatible)
# Get a free Gemini API key from https://aistudio.google.com/
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Isolated Code Execution Service (Judge0 / Piston)
# By default, Piston public engine is active for zero-configuration isolated runs.
# To use Judge0 via RapidAPI or self-hosted:
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_HOST=ce.judge0.com
PISTON_API_URL=https://emkc.org/api/v2/piston

# Execution Limits
EXECUTION_TIMEOUT_MS=7000
MAX_MEMORY_KB=128000
MAX_OUTPUT_CHARS=10000
